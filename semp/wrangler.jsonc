{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecoschool-sense",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-04",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "izy-sensors",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "../worker/migrations"
    }
  ]
}
